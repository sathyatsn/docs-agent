# Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth credentials file path
GOOGLE_CREDENTIALS_PATH=config/credentials.json

# Google OAuth token storage path
GOOGLE_TOKEN_PATH=config/token.json

# How far back (in hours) to look for completed meetings
MEETING_LOOKBACK_HOURS=2

# Claude model to use for summarization
CLAUDE_MODEL=claude-sonnet-5

# Polling interval in minutes (how often to check for new meetings)
POLL_INTERVAL_MINUTES=15

# Optional: specific calendar ID (defaults to primary)
GOOGLE_CALENDAR_ID=primary

# Optional: Google Drive folder ID where Gemini notes are saved
GEMINI_NOTES_FOLDER_ID=

# Optional: Google Drive folder ID for output docs (if creating new docs)
OUTPUT_FOLDER_ID=

# --- Release Ticket Agent (release_agent.py) ---
# Jira Cloud site and API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://couchbasecloud.atlassian.net
JIRA_EMAIL=you@couchbase.com
JIRA_API_TOKEN=your-jira-api-token

# Claude model used only to split free-text release requests (Slack bot, intake command)
RELEASE_AGENT_MODEL=claude-opus-5-5

# Slack bot (slack_bot.py, Socket Mode). See slack/manifest.yaml.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Where pending release plans are stored (keep on persistent storage)
RELEASE_PLAN_STORE=config/release_plans.json
